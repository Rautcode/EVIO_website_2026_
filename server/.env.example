# EVIO API Server Configuration

# JWT Secret for Admin Panel Auth
JWT_SECRET=your_super_secret_jwt_key_here
PORT=5000

# Behind a reverse proxy/load balancer, set to the number of proxy hops (usually 1) so rate
# limits see the real visitor IP. Leave empty when Node faces the internet directly.
TRUST_PROXY=

# Dev only: set to true to switch rate limits off while testing (ignored in production).
DISABLE_RATE_LIMIT=

# Only used when the database has no admin user yet. If empty, a random one-time password
# is generated and printed to the console.
ADMIN_PASSWORD=

# Extra allowed browser origins (comma-separated). evio.in and www.evio.in are always allowed.
CORS_ORIGINS=

# ==========================================
# SMTP Email Configuration (Nodemailer)
# ==========================================
# Use your email provider's SMTP settings. 
# For Gmail, use an "App Password" rather than your real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME="EVIO Website"

# ==========================================
# Department / Role Routing Emails
# ==========================================
# These emails will receive the categorized inquiries and applications.
# Each address below has a built-in @evio.in default if left empty.

# Sales leads (Contact form, RFQs, brochure downloads)
# Data Center -> SMTP_DATACENTRE_EMAIL (falls back to projects), Automation / IBMS -> SMTP_AUTOMATION_EMAIL,
# everything else -> SMTP_PROJECTS_EMAIL
SMTP_DATACENTRE_EMAIL=
SMTP_PROJECTS_EMAIL=projects@evio.in
SMTP_AUTOMATION_EMAIL=automation@evio.in

# Job Applications (Careers form). Unmapped roles fall back to SMTP_HR_EMAIL.
SMTP_HR_EMAIL=hr@evio.in
SMTP_ENGINEERING_EMAIL=engineering_jobs@evio.in
SMTP_MANAGEMENT_EMAIL=management@evio.in
SMTP_OPERATIONS_EMAIL=operations@evio.in
